# ALÊ ADT ABAP — Credenciais do servidor SAP
# Copie este arquivo para setup/.env e preencha os valores reais.
# NUNCA commite o .env com senhas reais.

# Obrigatórias
SAP_URL=https://seuhost:44300
SAP_USER=SEU_USUARIO
SAP_PASS=SUA_SENHA

# Opcionais
SAP_CLIENT=100
SAP_LANG=PT
SAP_INSECURE_SSL=false
MCP_PORT=3000
